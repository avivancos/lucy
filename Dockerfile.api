FROM python:3.12-slim

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
COPY packages ./packages

# Dev extras are the sanctioned Docker path for tests, lint, and type checks.
RUN pip install --no-cache-dir -e ".[dev]"
RUN pip install --no-cache-dir \
    -e packages/lucy-fixture-plugin \
    -e packages/lucy-deepgram \
    -e packages/lucy-elevenlabs \
    -e packages/lucy-openai

EXPOSE 8000

CMD ["uvicorn", "lucy.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
